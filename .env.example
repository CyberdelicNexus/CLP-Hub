# ---------------------------------------------------------------------------
# CLP Hub environment configuration
# Copy to .env.local for development. Never commit real values.
# All three environments (development | staging | production) use these keys.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Supabase project (browser-safe values). Used only for staff authentication.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_key

# Direct Postgres connection used by the server (Drizzle) and by scripts.
# Use the Supabase "Transaction pooler" URI in serverless environments.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Service-role key. SCRIPTS ONLY (seed). Never referenced by application code.
SUPABASE_SERVICE_ROLE_KEY=

# Seeding guard. The seed script refuses to run unless this is "true"
# and APP_ENV is not production. Seed data is synthetic and obviously fake.
ALLOW_DEMO_DATA=true
SEED_STAFF_PASSWORD=change-me-demo-password

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Shared secret for the Phase 8 scheduled-action processor
# (/api/internal/process-scheduled-actions). Sent as `Authorization: Bearer`.
# Leave unset in development: the endpoint refuses every request without it,
# so an unconfigured deployment is closed rather than open.
CRON_SECRET=
